# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
KGRAG_EXTRACTION_MODEL=claude-opus-5-5
KGRAG_SYNTHESIS_MODEL=claude-opus-5-5
# Router is deliberately a small, cheap model (Phase 3 spec).
KGRAG_ROUTER_MODEL=claude-haiku-5-5

# --- Cost safety -----------------------------------------------------------
# Hard cap on cumulative LLM spend (USD) recorded in the ledger. Calls abort before exceeding it.
KGRAG_BUDGET_USD=25.0
# Set to 1 to use the offline fake LLM + hash embedder (tests / dry runs; no network, no spend).
KGRAG_OFFLINE=0

# --- Stores ----------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kgrag-dev-password
PG_DSN=postgresql://kgrag:kgrag@localhost:5432/kgrag

# --- Embeddings ------------------------------------------------------------
# fastembed runs locally (ONNX, CPU). 384-dim.
KGRAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
KGRAG_EMBED_DIM=384

# --- Entity resolution -----------------------------------------------------
# Tuned with `python -m kgrag.eval.tune_er` against data/eval/er_pairs.jsonl.
KGRAG_ER_THRESHOLD=0.91

# --- Router ----------------------------------------------------------------
KGRAG_ROUTER_CONFIDENCE=0.70

# --- SEC EDGAR -------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address. Fill in your own.
SEC_USER_AGENT=
